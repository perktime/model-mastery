{
  // Codespace for the Claude + Microsoft Foundry workshop (anthropic/).
  "name": "Claude on Microsoft Foundry workshop",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "containerEnv": {
    "PIP_INDEX_URL": "https://packagefeedproxy.microsoft.io/pypi/simple",
    "NPM_CONFIG_REGISTRY": "https://packagefeedproxy.microsoft.io/npm/"
  },
  "features": {
    "ghcr.io/devcontainers/features/azure-cli:1": {
      "installBicep": true
    },
    "ghcr.io/azure/azure-dev/azd:0": {}
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-azuretools.vscode-bicep"]
    }
  },
  // Install what the labs need and create anthropic/.env from the template.
  "postCreateCommand": "cd anthropic && python -m pip install -r requirements.txt -r foundry-iq/requirements.txt && (test -f .env || cp .env.example .env)"
}
