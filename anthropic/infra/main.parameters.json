{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": { "value": "${AZURE_ENV_NAME}" },
    "resourceGroupName": { "value": "${AZURE_RESOURCE_GROUP}" },
    "createResourceGroup": { "value": "${CREATE_RESOURCE_GROUP=true}" },
    "location": { "value": "${AZURE_LOCATION}" },
    "foundryLocation": { "value": "${FOUNDRY_LOCATION=eastus2}" },
    "searchLocation": { "value": "${AZURE_SEARCH_LOCATION=eastus}" },
    "developerPrincipalId": { "value": "${AZURE_PRINCIPAL_ID}" },
    "developerPrincipalType": { "value": "${AZURE_PRINCIPAL_TYPE=User}" },
    "assignDeveloperRoles": { "value": "${ASSIGN_DEVELOPER_ROLES=true}" },
    "assignSearchRoles": { "value": "${ASSIGN_SEARCH_ROLES=true}" },
    "assignMonitoringRoles": { "value": "${ASSIGN_MONITORING_ROLES=true}" },
    "claudeOrganizationName": { "value": "${CLAUDE_ORGANIZATION_NAME}" },
    "claudeCountryCode": { "value": "${CLAUDE_COUNTRY_CODE}" },
    "claudeIndustry": { "value": "${CLAUDE_INDUSTRY}" },
    "useExistingFoundryProject": { "value": "${USE_EXISTING_AI_PROJECT=false}" },
    "existingFoundryAccountName": { "value": "${EXISTING_FOUNDRY_ACCOUNT_NAME=}" },
    "existingFoundryProjectName": { "value": "${EXISTING_FOUNDRY_PROJECT_NAME=}" },
    "enableMonitoring": { "value": "${ENABLE_MONITORING=true}" },
    "existingSearchName": { "value": "${EXISTING_AZURE_SEARCH_NAME=}" },
    "searchSku": { "value": "${AZURE_SEARCH_SKU=free}" },
    "knowledgeBaseName": { "value": "${KNOWLEDGE_BASE_NAME=cupcake-store-kb}" },
    "existingLogAnalyticsName": { "value": "${EXISTING_LOG_ANALYTICS_NAME=}" },
    "existingApplicationInsightsName": { "value": "${EXISTING_APPLICATIONINSIGHTS_NAME=}" },
    "existingMonitoringConnectionName": { "value": "${EXISTING_MONITORING_CONNECTION_NAME=}" },
    "dashboardName": { "value": "${APPLICATIONINSIGHTS_DASHBOARD_NAME=}" },
    "cupcakeMcpUrl": { "value": "${CUPCAKE_MCP_URL=}" },
    "enableEvaluatorConnection": { "value": "${ENABLE_EVALUATOR_CONNECTION=false}" },
    "evaluatorConnectionName": { "value": "${EVAL_ENDPOINT_CONNECTION=mm-eval-endpoint}" },
    "evaluatorEndpointUrl": { "value": "${EVAL_ENDPOINT_URL=}" },
    "evaluatorEndpointApiKey": { "value": "${EVAL_ENDPOINT_API_KEY=}" }
  }
}
