@@ -8,4 +8,8 @@ from azure.core.exceptions import ResourceExistsError, ResourceNotFoundError
 from azure.data.tables import TableServiceClient, UpdateMode
+from azure.identity import DefaultAzureCredential
 
+# Keyless (Entra ID) access is the default. AZURE_STORAGE_CONNECTION_STRING is
+# only for local development, e.g. Azurite.
 CONN_STR = os.environ.get("AZURE_STORAGE_CONNECTION_STRING", "")
+STORAGE_ACCOUNT_NAME = os.environ.get("AZURE_STORAGE_ACCOUNT_NAME", "")
 
@@ -25,4 +29,25 @@ def _generate_customer_id() -> str:
 
+_credential: DefaultAzureCredential | None = None
+
+
+def _get_credential() -> DefaultAzureCredential:
+    # Shared so the token cache survives across the many short-lived clients.
+    global _credential
+    if _credential is None:
+        _credential = DefaultAzureCredential()
+    return _credential
+
+
 def _client() -> TableServiceClient:
-    return TableServiceClient.from_connection_string(CONN_STR)
+    if CONN_STR:
+        return TableServiceClient.from_connection_string(CONN_STR)
+    if not STORAGE_ACCOUNT_NAME:
+        raise RuntimeError(
+            "Set AZURE_STORAGE_ACCOUNT_NAME (Entra ID access) or "
+            "AZURE_STORAGE_CONNECTION_STRING (local development only)."
+        )
+    return TableServiceClient(
+        endpoint=f"https://{STORAGE_ACCOUNT_NAME}.table.core.windows.net",
+        credential=_get_credential(),
+    )
 
